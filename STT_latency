#!/usr/bin/env python3

import os
import sys
import time
import asyncio
import wave
from dotenv import load_dotenv

project_root = os.path.dirname(os.path.abspath(__file__))
if project_root not in sys.path:
    sys.path.append(project_root)

load_dotenv(os.path.join(project_root, ".env"))

sarvam_key = os.getenv("Sarvam_key")
if not sarvam_key:
    print("=" * 60)
    print(" 🎙️  SARVAM AI SPEECH-TO-TEXT LATENCY BENCHMARK")
    print("=" * 60)
    print("❌ Error: 'Sarvam_key' not found in environment or .env file.")
    print("\nPlease create a '.env' file in the project root directory and add your key:")
    print("Sarvam_key=your_sarvam_api_key_here")
    print("=" * 60)
    sys.exit(1)

try:
    from app.services.STT import speech_to_text
except Exception as e:
    print(f"❌ Error: Could not import speech_to_text. Detail: {e}")
    sys.exit(1)


async def measure_stt_latency(audio_path: str):
    print("=" * 60)
    print(" 🎙️  SARVAM AI SPEECH-TO-TEXT LATENCY BENCHMARK")
    print("=" * 60)
 
    if not os.path.exists(audio_path):
        print(f"❌ Error: Audio file '{audio_path}' not found.")
        sys.exit(1)

    print(f"📂 Loading audio file: {audio_path}")
    try:
        with wave.open(audio_path, 'rb') as wf:
            channels    = wf.getnchannels()
            sample_width= wf.getsampwidth()
            framerate   = wf.getframerate()
            n_frames    = wf.getnframes()
            audio_bytes = wf.readframes(n_frames)
            duration    = n_frames / framerate

        print(f"   - Channels    : {channels} ({'Mono' if channels == 1 else 'Stereo'})")
        print(f"   - Sample Width: {sample_width * 8}-bit")
        print(f"   - Sample Rate : {framerate} Hz")
        print(f"   - Duration    : {duration:.2f} seconds") 
        print(f"   - Size        : {len(audio_bytes)} raw PCM bytes")
    except Exception as e:
        print(f"❌ Error reading wave file: {e}")
        sys.exit(1)

    try:
        NUM_RUNS  = 5
        BUDGET_MS = 400
        latencies = []

        for i in range(NUM_RUNS):
            print(f"\n⚡ Run {i+1}/{NUM_RUNS}...")
            start  = time.perf_counter()
            result = await speech_to_text(audio_bytes)
            end    = time.perf_counter()
            ms     = (end - start) * 1000
            latencies.append(ms)
            print(f"   {ms:.0f}ms")

        avg    = sum(latencies) / len(latencies)
        status = "✅ WITHIN BUDGET" if avg <= BUDGET_MS else f"❌ OVER BUDGET by {avg - BUDGET_MS:.0f}ms"

        print(f"\n── Results ─────────────────────────────")
        print(f"   Transcript : {result.get('transcript', '')}")
        print(f"   Average    : {avg:.0f}ms")
        print(f"   Min        : {min(latencies):.0f}ms")
        print(f"   Max        : {max(latencies):.0f}ms")
        print(f"   Status     : {status}")

    except Exception as e:
        print(f"\n❌ Error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    audio_file = sys.argv[1] if len(sys.argv) > 1 else "golden_test.wav"
    asyncio.run(measure_stt_latency(audio_file))