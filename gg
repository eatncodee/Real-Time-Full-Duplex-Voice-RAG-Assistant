import os
import requests

# Grab your Gemini API key from the environment variable we configured
gemini_api_key = os.getenv("key")

if not gemini_api_key:
    print("❌ Error: OPENAI_API_KEY environment variable is not set.")
    print("Please make sure your virtual environment is active and your .env file is loaded.")
    exit(1)

# Fetch the ground-truth model registry directly from Google
url = f"https://generativelanguage.googleapis.com/v1beta/models?key=AIzaSyCAPWAEWT_0RbW-ZUnm7Z9LMrZvZoy5t-Q"

try:
    response = requests.get(url)
    response.raise_for_status()
    data = response.json()
    
    embedding_models = []
    chat_models = []
    
    for model in data.get("models", []):
        # Strip the 'models/' prefix to get the clean identifier string
        model_id = model.get("name", "").replace("models/", "")
        display_name = model.get("displayName", "")
        methods = model.get("supportedGenerationMethods", [])
        
        # Sort based on capability tags
        if "embedContent" in methods:
            embedding_models.append((model_id, display_name))
        if "generateContent" in methods:
            chat_models.append((model_id, display_name))
            
    print("\n⚡ ================= AVAILABLE EMBEDDING MODELS ================= ⚡")
    for model_id, display in sorted(embedding_models):
        print(f"👉 Model ID: {model_id:<30} | {display}")
        
    print("\n💬 ================= AVAILABLE CHAT / TEXT MODELS ================= 💬")
    for model_id, display in sorted(chat_models):
        print(f"👉 Model ID: {model_id:<30} | {display}")

except requests.exceptions.HTTPError as http_err:
    print(f"❌ HTTP Error occurred: {http_err}")
except Exception as e:
    print(f"❌ Failed to retrieve models: {e}")